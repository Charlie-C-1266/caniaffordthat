{
  "name": "caniaffordthat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "npm run lint:oxlint && npm run lint:types",
    "lint:oxlint": "oxlint",
    "lint:types": "eslint src",
    "format": "prettier --write .",
